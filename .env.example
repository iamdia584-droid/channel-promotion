# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env. No secret belongs in source.
# ---------------------------------------------------------------------------

APP_ENV=development
APP_NAME=AdNet
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
BASE_URL=https://ads.example.com

# Postgres
DATABASE_URL=postgresql+psycopg://adnet:adnet@localhost:5432/adnet

# Redis
REDIS_URL=redis://localhost:6379/0

# Telegram — get the token from @BotFather. Keep it out of git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string; Telegram echoes it in X-Telegram-Bot-Api-Secret-Token so we can
# verify that a webhook call really came from Telegram.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook

# Optional MTProto view source (see docs/TELEGRAM_CONSTRAINTS.md). Leave empty to
# bill click-measured impressions only.
MTPROTO_ENABLED=false
MTPROTO_API_ID=
MTPROTO_API_HASH=
MTPROTO_SESSION=

# Money
DEFAULT_CURRENCY=BDT

# Admin bootstrap (first admin only; rotate the password after first login)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
ADMIN_REQUIRE_2FA=true

# Security
ALLOWED_HOSTS=*
CORS_ORIGINS=
RATE_LIMIT_ENABLED=true
